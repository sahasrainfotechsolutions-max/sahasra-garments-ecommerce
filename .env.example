# SAHASRA GARMENTS E-COMMERCE MASTER TEMPLATE ENVIRONMENT CONFIGURATION

# Database Connection (PostgreSQL / Supabase)
# For Supabase on Netlify/Production:
# DATABASE_URL uses the Transaction / Session Pooler (port 6543 or 5432)
# DIRECT_URL uses the Direct Connection (port 5432)
DATABASE_URL="postgresql://postgres:admin123@localhost:5432/sahasra_garments?schema=public"
DIRECT_URL="postgresql://postgres:admin123@localhost:5432/sahasra_garments?schema=public"
SUPABASE_DATABASE_URL="postgresql://postgres:Sahasra%40143@db.xgkpgpcnffnjzyynuayz.supabase.co:5432/postgres"

# Authentication Secret (JWT session signing)
AUTH_SECRET="your-super-secure-jwt-secret-key-min-32-characters"

# Store URL
NEXT_PUBLIC_STORE_URL="https://your-store-domain.com"

# Default Demo Admin Credentials (For initial seed)
ADMIN_DEFAULT_EMAIL="admin@sahasra.com"
ADMIN_DEFAULT_PASSWORD="Admin@12345"

# Multi-Tenant Active Store ID (Master default is 'default-store')
DEFAULT_STORE_ID="default-store"

# Payment Providers (Configurable)
NEXT_PUBLIC_ENABLE_COD="true"
NEXT_PUBLIC_ENABLE_ONLINE_PAYMENT="true"
PAYMENT_PROVIDER_KEY=""
PAYMENT_PROVIDER_SECRET=""

# Cloud / Object Storage (Future / Optional)
IMAGE_STORAGE_URL=""
